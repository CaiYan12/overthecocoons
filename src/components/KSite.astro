---
// 站点外壳（v-kinetic）：背景材质、紧凑 header、可选 Hero、三栏（左右栏经插槽注入）、
// 页脚、返回顶部与 Ticket 06 动效挂点（自定义光标，静态层不可见）。
// T4（UI 票 #21）：页面过渡面板 DOM 已删除（客户端零驱动的死代码，P2 改用原生 View Transition）。
import BaseLayout from "../layouts/BaseLayout.astro";
import KHeader from "./KHeader.astro";
import KMenu from "./KMenu.astro";
import SiteFooter from "./SiteFooter.astro";
import { formatDateTime, latestDayStats, sortEntriesDesc, topicTabs } from "../lib/timeline.ts";
import { loadSnapshot } from "../lib/snapshot.ts";

interface Props {
  title: string;
  description: string;
  /** 数据页传快照 isFixture（页脚标注演示数据）；纯说明页传 false。 */
  isFixture: boolean;
  /** 当前激活主题（header tab / 菜单主题列）。 */
  activeTopic?: string;
  /** 当前激活的站点导航项。 */
  activeNav?: string;
  /**
   * ≤767px 时 HUD 是否排到主内容之前（UI 票 #10）：时间线页传 true（进度 HUD 随列表前置），
   * 详情/说明页不传（用户先看到内容，SOURCE/STATUS/PROJECT 移到正文之后）。
   */
  hudMobileFirst?: boolean;
}
const { title, description, isFixture, activeTopic = "全部", activeNav, hudMobileFirst } = Astro.props;

// 构建期读取快照，仅为 header/菜单/页脚提供时间基准、当日条数与主题 tab 降权视图；页面主体数据由各页自行渲染。
const snapshot = loadSnapshot();
const snapTime = formatDateTime(snapshot.generatedAt);
const { count: todayCount } = latestDayStats(sortEntriesDesc(snapshot.entries));
// T9 空主题 tab 降权：构建期按快照统计，非空按条数置前、空主题置后（规则确定性，入口保留）
const tabs = topicTabs(snapshot.entries);
---

<BaseLayout title={title} description={description}>
  <div class="v-kinetic" data-kinetic>
    <div class="k-grain" aria-hidden="true"></div>
    <KHeader activeTopic={activeTopic} topicTabs={tabs} />
    <slot name="hero" />
    <div class={`k-cols${hudMobileFirst ? " hud-first" : ""}`}>
      <slot name="col-start" />
      <main class="k-main" id="main" data-kmain>
        <slot />
      </main>
      <slot name="col-end" />
    </div>
    <SiteFooter isFixture={isFixture} active={activeNav} />
    <!-- 全局状态播报区（Ticket 05）：主题/位置/复制等反馈；fixed 定位，不随 DOM 位置变化 -->
    <p class="live-status" role="status" aria-live="polite" data-status></p>
    <button class="k-top" type="button" data-ktop data-cursor-soft aria-label="返回顶部">
      <svg viewBox="0 0 60 60" aria-hidden="true">
        <circle class="track" cx="30" cy="30" r="26"></circle>
        <circle class="prog" data-ring cx="30" cy="30" r="26"></circle>
      </svg>
      <span class="arr" aria-hidden="true">↑</span>
    </button>
    <KMenu
      activeTopic={activeTopic}
      activeNav={activeNav}
      snapTime={snapTime}
      isFixture={isFixture}
      todayCount={todayCount}
      topicTabs={tabs}
    />
    <!-- 页面过渡面板 DOM 已删除（T4，UI 票 #21）：见本文件头注释 -->
    <!-- 自定义光标（UI 票 #14）：反相混合作用在 .k-cursor 容器上（写在子元素上会被容器自身的
         隔离组屏蔽，实测渲染为原始白色）；语义标签必须留在容器之外——容器内会随背景一起反相，
         accent 红会漂成青绿，故标签作为兄弟元素独立跟随鼠标 -->
    <div class="k-cursor" data-kcursor aria-hidden="true">
      <span class="k-cursor-ring" data-kcursor-ring></span>
      <span class="k-cursor-dot" data-kcursor-dot></span>
    </div>
    <span class="k-cursor-label" data-kcursor-label aria-hidden="true"></span>
  </div>
  <!-- 客户端增强入口（Ticket 05）：单模块按挂点初始化；无 JS 时页面保持静态可读 -->
  <script src="../client/index.ts"></script>
</BaseLayout>
