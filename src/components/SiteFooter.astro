---
// 页脚：页面导航（移动端无 JS 时的站内链接兜底）+ 主题导航（≤767px 显示，补无 JS 主题入口）
// + 数据/许可说明。
import { TOPICS, topicPagePath } from "../lib/timeline.ts";
import { siteUrl } from "../lib/paths.ts";

interface Props {
  isFixture: boolean;
  active?: string;
}
const { isFixture, active } = Astro.props;

const links = [
  { key: "home", label: "时间线", href: siteUrl("/") },
  { key: "sources", label: "来源", href: siteUrl("/sources/") },
  { key: "about", label: "关于", href: siteUrl("/about/") },
  { key: "principles", label: "原则", href: siteUrl("/principles/") },
  { key: "privacy", label: "隐私", href: siteUrl("/privacy/") },
];
---

<footer>
  <nav class="k-foot-nav" aria-label="页面导航">
    {
      links.map((link) => (
        <a href={link.href} aria-current={active === link.key ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <nav class="k-foot-topics" aria-label="主题导航">
    {
      TOPICS.map((topic) => (
        <a href={siteUrl(topicPagePath(topic, 1))}>{topic}</a>
      ))
    }
  </nav>
  <p>
    {
      isFixture
        ? "当前页面展示仓库内置的合成演示数据，不代表真实新闻；收录时间、主题与来源字段仅演示信息层级。"
        : "公共时间线按同一份数据快照与共同排序规则展示，不按个人行为排序。"
    }
  </p>
  <p>MIT · CaiYan12 · 无广告 · 无访问统计 · 不记录阅读历史</p>
</footer>
