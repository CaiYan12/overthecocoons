---
// 长文页（关于/原则/隐私）：左栏全站导航 + 本页目录、正文、右栏内容态 HUD。
// 导航分组与短屏策略见 docs/ui-navigation-alignment.md；原生锚点由 navigation-motion 渐进增强章节跟踪。
import KSite from "./KSite.astro";
import KDocNav from "./KDocNav.astro";
import KHud from "./KHud.astro";
import { loadSnapshot } from "../lib/snapshot.ts";

export interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  lede: string;
  activeNav: string;
  toc: TocItem[];
}
const { title, description, heading, lede, activeNav, toc } = Astro.props;
const snapshot = loadSnapshot();
---

<KSite
  title={title}
  description={description}
  isFixture={false}
  activeTopic="全部"
  activeNav={activeNav}
  footerInColumns
>
  <Fragment slot="col-start">
    <KDocNav active={activeNav} toc={toc} />
  </Fragment>

  <article class="k-doc" data-longform-motion>
    <h1>{heading}</h1>
    <p class="k-doc-lede">{lede}</p>
    <slot />
  </article>

  <Fragment slot="col-end">
    <KHud variant="content" snapshotGeneratedAt={snapshot.generatedAt} isFixture={snapshot.isFixture} />
  </Fragment>
</KSite>
