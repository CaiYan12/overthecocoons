---
// 长文页（关于/原则/隐私）：左栏全站导航 + 本页目录、正文、右栏内容态 HUD。
// 导航分组与短屏策略见 docs/ui-navigation-alignment.md；目录为原生章节锚点。
import KSite from "./KSite.astro";
import KNav from "./KNav.astro";
import KHud from "./KHud.astro";
import { loadSnapshot } from "../lib/snapshot.ts";

export interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  lede: string;
  activeNav: string;
  toc: TocItem[];
}
const { title, description, heading, lede, activeNav, toc } = Astro.props;
const snapshot = loadSnapshot();
---

<KSite
  title={title}
  description={description}
  isFixture={false}
  activeTopic="全部"
  activeNav={activeNav}
  footerInColumns
>
  <Fragment slot="col-start">
    <div class="k-docnav" data-docnav>
      <KNav active={activeNav} />
      <aside class="k-toccol" aria-label="本页目录">
        <p class="k-navhead">本页目录 · TOC</p>
        <nav class="k-toc" data-toc>
          <ol>
            {toc.map((item) => (
              <li><a href={`#${item.id}`} data-cursor-soft tabindex="0">{item.label}</a></li>
            ))}
          </ol>
        </nav>
      </aside>
    </div>
  </Fragment>

  <article class="k-doc">
    <h1>{heading}</h1>
    <p class="k-doc-lede">{lede}</p>
    <slot />
  </article>

  <Fragment slot="col-end">
    <KHud variant="content" snapshotGeneratedAt={snapshot.generatedAt} isFixture={snapshot.isFixture} />
  </Fragment>
</KSite>
