---
// 数据版画占位图（无图条目的本站占位）：网格底纹 + 色块时间 + 丝纹（T13）。
// 结构与原型 .k-media/.k-media-tilt/.k-media-art 三层一致（T14/UI 票 #31 恢复 tilt 中间层——
// T11 移除撤销，tilt 包裹整个 art 层；版画 clip 揭示作用于 .k-media）。
// T9 版面减负（UI 票 #26）：移除出血大序号与竖排英文主题词——线上真实数据主题恒为单一值，
// 逐条重复同词零信息量；序号是快照内可数位置而非编辑编排（ADR 0003），不再以大字呈现，
// 阅读位计数仍由 HUD NOW READING n/N 承担。色块时间与网格底纹保留。
// T13（UI 票 #30）丝纹：构建期由条目稳定 ID（seedId）经 src/lib/silk.ts 派生确定性 SVG 曲线，
// 注入版画让每条版画携带独有信息（T9 的替代物）；客户端重渲染由 timeline-view 用同一函数
// 注入同构标记。纯装饰 aria-hidden 语义不变（T9 语义重订），零运行时开销。
import { SILK_VIEWBOX, silkSidLabel, silkTexturePaths } from "../lib/silk.ts";

interface Props {
  /** 色块时间（HH:mm）。 */
  clock: string;
  /** 丝纹种子＝条目稳定 ID（64hex）。 */
  seedId: string;
}
const { clock, seedId } = Astro.props;
const paths = silkTexturePaths(seedId);
const sid = silkSidLabel(seedId);
---

<div class="k-media" data-cursor="OPEN">
  <div class="k-media-tilt">
    <div class="k-media-art" aria-hidden="true">
      <span class="tag">
        <i></i>
        <span class="tm">{clock}</span>
      </span>
      <svg class="silk-texture" viewBox={SILK_VIEWBOX} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        {paths.map((p) => (
          <path class={p.cls} d={p.d} stroke-width={p.width} opacity={p.opacity} />
        ))}
      </svg>
      <span class="sid">{sid}</span>
    </div>
  </div>
</div>
