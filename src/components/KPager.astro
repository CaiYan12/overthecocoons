---
import { pagerHtml } from "../lib/pager.ts";

interface Props {
  page: number;
  totalPages: number;
  hrefFor: (page: number) => string;
}
const { page, totalPages, hrefFor } = Astro.props;
---

{totalPages > 1 && <nav class="pager" data-pager aria-label="分页" set:html={pagerHtml(page, totalPages, hrefFor)} />}
