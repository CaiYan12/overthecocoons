---
// 紧凑吸顶导航：品牌、主题 tab（真实链接，无 JS 可点）、显示模式与菜单入口（Ticket 06 接管行为）。
import { TOPICS, topicPagePath } from "../lib/timeline.ts";
import { siteUrl } from "../lib/paths.ts";

interface Props {
  /** 当前激活主题（决定 tab 的 aria-current）。 */
  activeTopic?: string;
}
const { activeTopic = "全部" } = Astro.props;
---

<header class="k-header" data-kheader>
  <a class="k-brand" href={siteUrl("/")} data-cursor-soft>跳出茧房</a>
  <nav class="k-tabs" role="tablist" aria-label="主题筛选" data-ktabs>
    <span class="k-indicator" aria-hidden="true" data-indicator></span>
    {
      TOPICS.map((topic) => (
        <a
          class="tab"
          role="tab"
          aria-current={topic === activeTopic ? "true" : "false"}
          data-topic={topic}
          data-cursor-soft
          href={siteUrl(topicPagePath(topic, 1))}
        >
          {topic}
        </a>
      ))
    }
  </nav>
  <div class="k-head-actions">
    <button class="mode-btn" type="button" data-mode data-cursor-soft>显示：浅色</button>
    <button class="k-menu-open" type="button" data-kmenu-open data-cursor-soft aria-haspopup="dialog" aria-expanded="false">MENU</button>
  </div>
</header>
