---
// 时间线条目（v-kinetic）：72/28/1fr 网格 + 两档版式 + 数据版画占位图（无图条目的本站占位）。
// 版式口径见 docs/adr/0003-timeline-hierarchy-and-time-presentation.md（T7 版式诚实化）：
// - 不设位置型头条档；有摘要 = 标准版式（di 奇偶交替图左/图右，di=0 归偶），
//   无摘要 = 紧凑行（无版画、无摘要段）——两档判定只用「有无摘要」这一内容事实；
// - 日组头为批次形态（同日分钟全相同）时省略条目行时间（omitTime）。
// 标题为站内详情链接（data-detail 为 Ticket 05/06 挂点）。
import type { PublicEntry } from "../domain/contract.ts";
import { entryLayout, formatClock, formatDateTime, itemPath } from "../lib/timeline.ts";
import { siteUrl } from "../lib/paths.ts";
import KEntryMedia from "./KEntryMedia.astro";
import KEntryMeta from "./KEntryMeta.astro";

interface Props {
  entry: PublicEntry;
  /** 全局序号（0 起，跨页连续），用于 data-gi（客户端阅读位定位与恢复）。 */
  gi: number;
  /** 日内序号（0 起），标准版式按奇偶交替取版面。 */
  di: number;
  /** 日组头为批次形态（分钟全相同）时省略条目行时间（ADR 0003）。 */
  omitTime: boolean;
}
const { entry, gi, di, omitTime } = Astro.props;
const layout = entryLayout(di, Boolean(entry.summary));
const clock = formatClock(entry.firstSeenAt);
const collected = formatDateTime(entry.firstSeenAt);
const detailHref = siteUrl(itemPath(entry.id));
---

<article class={`k-entry ${layout}`} data-entry data-gi={gi}>
  {
    !omitTime && (
      <div class="k-time">
        <time datetime={entry.firstSeenAt}>{clock}</time>
      </div>
    )
  }
  <div class="k-node-rail" aria-hidden="true"><span class="k-node"></span></div>
  <div class="k-body">
    {
      layout === "layout-compact" ? (
        <div class="k-body-inner">
          <div class="k-text">
            <h3 class="k-headline">
              <a href={detailHref} data-detail data-cursor="VIEW">{entry.title}</a>
            </h3>
            <KEntryMeta topic={entry.topic} collected={collected} url={entry.url} />
          </div>
        </div>
      ) : (
        <div class="k-body-inner">
          {
            layout === "layout-a" && (
              <Fragment>
                <div class="k-text">
                  <h3 class="k-headline">
                    <a href={detailHref} data-detail data-cursor="VIEW">{entry.title}</a>
                  </h3>
                  {entry.summary && <p class="k-summary">{entry.summary}</p>}
                  <KEntryMeta topic={entry.topic} collected={collected} url={entry.url} />
                </div>
                <KEntryMedia clock={clock} />
              </Fragment>
            )
          }
          {
            layout === "layout-b" && (
              <Fragment>
                <KEntryMedia clock={clock} />
                <div class="k-text">
                  <h3 class="k-headline">
                    <a href={detailHref} data-detail data-cursor="VIEW">{entry.title}</a>
                  </h3>
                  {entry.summary && <p class="k-summary">{entry.summary}</p>}
                  <KEntryMeta topic={entry.topic} collected={collected} url={entry.url} />
                </div>
              </Fragment>
            )
          }
        </div>
      )
    }
  </div>
</article>
