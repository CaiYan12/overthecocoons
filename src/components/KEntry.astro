---
// 时间线条目（v-kinetic）：72/28/1fr 网格 + 日内权重三档 + 数据版画占位图（无图条目的本站占位）。
// 版面分配与原型 kineticEntryHTML 一致：di=0 layout-c（图在文内），di 奇 layout-a（图右），di 偶 layout-b（图左）。
// 标题为站内详情链接（data-detail 为 Ticket 05/06 挂点）。
import type { PublicEntry } from "../domain/contract.ts";
import { EN_LABEL, entryWeights, formatClock, formatDateTime, itemPath } from "../lib/timeline.ts";
import { siteUrl } from "../lib/paths.ts";
import KEntryMedia from "./KEntryMedia.astro";
import KEntryMeta from "./KEntryMeta.astro";

interface Props {
  entry: PublicEntry;
  /** 全局序号（0 起，跨页连续），用于数据版画出血大序号与 data-gi。 */
  gi: number;
  /** 日内序号（0 起），决定权重三档与版面。 */
  di: number;
}
const { entry, gi, di } = Astro.props;
const { layout, weight } = entryWeights(di);
const clock = formatClock(entry.firstSeenAt);
const collected = formatDateTime(entry.firstSeenAt);
const lab = EN_LABEL[entry.topic] ?? "INDEX";
const num = String(gi + 1).padStart(2, "0");
const detailHref = siteUrl(itemPath(entry.id));
---

<article class={`k-entry ${layout} ${weight}`} data-entry data-gi={gi}>
  <div class="k-time"><time datetime={entry.firstSeenAt}>{clock}</time></div>
  <div class="k-node-rail" aria-hidden="true"><span class="k-node"></span></div>
  <div class="k-body">
    <div class="k-body-inner">
      {
        layout === "layout-a" && (
          <Fragment>
            <div class="k-text">
              <h3 class="k-headline">
                <a href={detailHref} data-detail data-cursor="VIEW">{entry.title}</a>
              </h3>
              {entry.summary && <p class="k-summary">{entry.summary}</p>}
              <KEntryMeta topic={entry.topic} collected={collected} url={entry.url} />
            </div>
            <KEntryMedia lab={lab} clock={clock} num={num} />
          </Fragment>
        )
      }
      {
        layout === "layout-b" && (
          <Fragment>
            <KEntryMedia lab={lab} clock={clock} num={num} />
            <div class="k-text">
              <h3 class="k-headline">
                <a href={detailHref} data-detail data-cursor="VIEW">{entry.title}</a>
              </h3>
              {entry.summary && <p class="k-summary">{entry.summary}</p>}
              <KEntryMeta topic={entry.topic} collected={collected} url={entry.url} />
            </div>
          </Fragment>
        )
      }
      {
        layout === "layout-c" && (
          <div class="k-text">
            <h3 class="k-headline">
              <a href={detailHref} data-detail data-cursor="VIEW">{entry.title}</a>
            </h3>
            <KEntryMedia lab={lab} clock={clock} num={num} />
            {entry.summary && <p class="k-summary">{entry.summary}</p>}
            <KEntryMeta topic={entry.topic} collected={collected} url={entry.url} />
          </div>
        )
      }
    </div>
  </div>
</article>
