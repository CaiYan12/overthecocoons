---
import "../styles/global.css";
import "../styles/kinetic.css";
import { DISPLAY_FONT_PATH } from "../lib/display-font.ts";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// 显式拼接基路径，避免绝对路径资源脱离 /overthecocoons 前缀
const motionBase = import.meta.env.BASE_URL.replace(/\/$/, "");
const faviconHref = `${motionBase}/favicon.svg`;
// T12（UI 票 #29）：展示字体子集 preload——early fetch，拆字 intro 与大字首绘前就位。
// 同源字体也必须带 crossorigin（font 请求恒为 CORS 模式，preload 缺该属性会二次下载）；
// @font-face 见下方内联 style（同一 URL，命中同一请求）。
const fontHref = `${motionBase}${DISPLAY_FONT_PATH}`;
// 审查修复（dev 全动效失效）：@font-face 内联并经 BASE_URL 拼接 URL——kinetic.css 里的
// 相对 url("../fonts/") 在构建产物（_astro/*.css）下解析正确，但 dev 下按文档/模块 URL
// 解析会 404（字体断链掉兜底）；内联保证 dev 与产物命中同一 URL，preload 同请求命中。
const fontFaceCss = `@font-face{font-family:"Source Han Serif SC Heavy Subset";src:url("${fontHref}") format("woff2");font-weight:700;font-style:normal;font-display:swap}`;
---

<!doctype html>
<!-- T4（UI 票 #21）：初值 auto（跟随系统），CSS prefers-color-scheme 映射无 JS 亦生效；
     head 脚本仅在存在持久化偏好时覆盖（循环语义不变） -->
<html lang="zh-CN" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="preload" as="font" type="font/woff2" href={fontHref} crossorigin="anonymous" />
    <style is:inline set:html={fontFaceCss} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // 启动主题恢复 + 预绘制遮蔽（Ticket 06 FOUC 裁定，见 task-06-report.md）：
      // 1) 任何模块脚本执行前恢复持久化主题，消除深色偏好用户的刷新闪色；
      // 2) 非 reduced-motion 下打 data-oct-pending（CSS 遮蔽 Hero 初始态，
      //    避免「先画静态层 → JS 再隐藏 → 再播 intro」的闪动）；
      // 3) 本地模块失效时由 1500ms 兜底解除遮蔽，内容不会滞留隐藏。
      // 4) 尽早禁用浏览器刷新滚动恢复：本票起 body 末端有阻塞式动效库脚本（Ticket 08 起自托管），
      //    打包模块（deferred）执行时点被网络延迟推后，晚于 Chrome 的恢复时点；
      //    scrollRestoration=manual 必须在 head 内联脚本（首个 JS）设置才可靠。
      // 这是内联 <script>（非内联事件处理器），无 on* 属性，隐私约束不变。
      (function () {
        try {
          if ("scrollRestoration" in history) {
            history.scrollRestoration = "manual";
          }
        } catch (error) {
          /* 沙箱环境禁用 history 访问时忽略：模块内仍会尝试设置 */
        }
        try {
          var stored = localStorage.getItem("overthecocoons.theme");
          if (stored === "light" || stored === "dark" || stored === "auto") {
            document.documentElement.dataset.theme = stored;
          }
          // 无存储：保持 HTML 初值 auto（跟随系统，T4/UI 票 #21），不回退 light
        } catch (error) {
          /* 存储不可用（隐私模式）：保持 auto 初值，模块内再降级内存态 */
        }
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.setAttribute("data-oct-pending", "");
          setTimeout(function () {
            document.documentElement.removeAttribute("data-oct-pending");
          }, 1500);
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <!-- 动效库（Ticket 06 引入，Ticket 08 自托管裁定）：GSAP Core + ScrollTrigger 3.13.0
         自托管于 public/vendor/（文件与 cdnjs 官方发布逐字节一致，SRI 摘要实测校验后沿用），
         站点运行期零外链请求；加载失败时客户端模块整体退化为无动效静态层 -->
    <script
      src={`${motionBase}/vendor/gsap.min.js`}
      integrity="sha384-HOvlOYPIs/zjoIkWUGXkVmXsjr8GuZLV+Q+rcPwmJOVZVpvTSXQChiN4t9Euv9Vc"
      crossorigin="anonymous"
    ></script>
    <script
      src={`${motionBase}/vendor/ScrollTrigger.min.js`}
      integrity="sha384-P8VzCVnT9NBUkMrpcIZrJbA7EBjJvh/fJS6PmP+4nLIM284DtsImIv8D0fFjIkeh"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
